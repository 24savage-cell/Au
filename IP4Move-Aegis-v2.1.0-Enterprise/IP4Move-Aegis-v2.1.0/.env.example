# IP4Move-Aegis v2.0 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ==================== 基础配置 ====================
# 运行环境: development, production, testing
IP4MOVE_ENV=development

# 服务配置
HOST=0.0.0.0
PORT=8080
WORKERS=1

# ==================== 安全配置 ====================
# 生产环境必须设置!!!
# 生成命令: openssl rand -hex 32
AEGIS_MASTER_SECRET=your-secure-master-secret-key-here-32chars

# API密钥配置
API_KEY_HEADER=X-API-Key
MAX_API_KEYS_PER_USER=100

# 速率限制
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=1000

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 是否使用JSON格式日志（生产环境建议开启）
JSON_LOGS=false

# ==================== DHT配置 ====================
DHT_NODE_ID=
DHT_ADDRESS=0.0.0.0
DHT_PORT=9050
DHT_ROUTING_TABLE_SIZE=160

# ==================== Mixnet配置 ====================
MIXNET_DELAY_MIN_MS=50
MIXNET_DELAY_MAX_MS=5000
MIXNET_BATCH_SIZE=64
MIXNET_FLUSH_INTERVAL_MS=100

# ==================== 监控配置 ====================
# Prometheus指标端点
METRICS_ENABLED=true
METRICS_PATH=/metrics

# 健康检查端点
HEALTH_PATH=/health

# ==================== CORS配置 ====================
# 多个来源用逗号分隔
# In production, do NOT include localhost origins.
# CORS_ORIGINS=https://ip4move.org,https://admin.ip4move.org
CORS_ORIGINS=https://ip4move.org,https://admin.ip4move.org

# ==================== 可选: 数据库配置 ====================
# DATABASE_URL=postgresql://user:password@localhost/ip4move
# REDIS_URL=redis://localhost:6379/0

# ==================== 可选: 外部服务配置 ====================
# SIEM_ENDPOINT=https://siem.example.com/api/v1/events
# SIEM_API_KEY=your-siem-api-key
